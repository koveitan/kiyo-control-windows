<Window x:Class="KiyoControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiyo Control"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1180" Height="780" MinWidth="1000" MinHeight="640"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveCommand" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: profile, menu, tabs, reset -->
        <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="ProfileBox" Width="220" SelectionChanged="OnProfileSelected" ToolTip="Profile" />
                <Button x:Name="MoreButton" Style="{StaticResource PlainButton}" Margin="12,0,0,0" Padding="6,4"
                        Click="OnMoreClicked" ToolTip="Profiles, backups and firmware">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE712;" FontSize="16" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="CameraTabButton" Style="{StaticResource PillTab}" Content="CAMERA" GroupName="Tabs" IsChecked="True" Checked="OnTabChecked" />
                <RadioButton x:Name="ProcessingTabButton" Style="{StaticResource PillTab}" Content="PROCESSING" GroupName="Tabs" Checked="OnTabChecked" />
                <RadioButton x:Name="ImageTabButton" Style="{StaticResource PillTab}" Content="IMAGE" GroupName="Tabs" Checked="OnTabChecked" />
            </StackPanel>
            <Button x:Name="ResetAllButton" Grid.Column="2" Style="{StaticResource PlainButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="OnResetAll">
                <TextBlock Text="Reset All Settings" TextDecorations="Underline" Foreground="#D9D9D9" />
            </Button>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />

        <!-- Settings panel and preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SettingsScroll" Background="{StaticResource PanelBrush}" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="SettingsHost" Margin="20,0,20,20" />
            </ScrollViewer>
            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />
            <Grid Grid.Column="2" Background="Black">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                <TextBlock x:Name="PreviewStatus" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="420" Foreground="{StaticResource SecondaryTextBrush}" />
                <Border x:Name="ErrorBanner" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16"
                        Background="#E6262626" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="#F5C518" VerticalAlignment="Center" />
                        <TextBlock x:Name="ErrorText" Margin="8,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                        <Button Style="{StaticResource GreyButton}" Content="Dismiss" Click="OnDismissError" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource DividerBrush}" />

        <!-- Bottom bar: save, revert, summary, preview mode and switch -->
        <DockPanel Grid.Row="4" Background="{StaticResource SurfaceBrush}" Margin="16,10" LastChildFill="True">
            <Button x:Name="SaveButton" Style="{StaticResource GreenButton}" Content="SAVE" Click="OnSave"
                    ToolTip="Saves this profile (Ctrl+S). Razer settings are also stored in the camera, so they stick without the app." />
            <Button x:Name="RevertButton" Style="{StaticResource GreyButton}" Content="Revert" Margin="14,0,0,0" Click="OnRevert"
                    VerticalAlignment="Center" ToolTip="Go back to the last saved settings of this profile" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Usb2Warning" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           ToolTip="The camera offers no 4K, which usually means a USB 2 connection (e.g. through a keyboard or monitor hub). Plug it into a USB 3 port for 4K.">
                    <Run FontFamily="{StaticResource IconFont}" Foreground="#F5C518" Text="&#xE7BA;" /> USB 2?
                </TextBlock>
                <ComboBox x:Name="ModeBox" Width="140" Margin="0,0,16,0" SelectionChanged="OnModeSelected"
                          ToolTip="Resolution and frame rate of this preview. Zoom, Teams, OBS and other apps choose their own when they turn the camera on." />
                <TextBlock Text="PREVIEW" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ToggleButton x:Name="PreviewSwitch" Style="{StaticResource Switch}" Click="OnPreviewToggled" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#D9D9D9"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>

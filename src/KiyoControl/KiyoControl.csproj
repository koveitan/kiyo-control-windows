<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app: WPF window, live preview (Windows.Media.Capture) and a tray icon. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version unlocks Windows.Media.Capture for the live preview. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KiyoControl</AssemblyName>
    <RootNamespace>KiyoControl</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's Fluent theme (ThemeMode) is marked experimental. -->
    <!-- WFO0003: the DPI manifest entries are for WPF, which has no SetHighDpiMode API. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms both define Application, Button…; only the tray icon uses WinForms, fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Program.Main starts the app, so Velopack can run first. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kiyo.Core\Kiyo.Core.csproj" />
    <ProjectReference Include="..\Kiyo.Windows\Kiyo.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
